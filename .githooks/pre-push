#!/bin/sh
# Git Pre-Push Hook for vienueTTS_server
echo "========================================================="
echo "🔍 [PRE-PUSH HOOK] Running vienueTTS_server pytest suite..."
echo "========================================================="

python -m pytest tests/ -v
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [PRE-PUSH HOOK FAILED] Tests failed in vienueTTS_server!"
    echo "   Please fix failing tests before pushing."
    echo "========================================================="
    exit 1
fi

echo ""
echo "✅ [PRE-PUSH HOOK PASSED] All vienueTTS_server tests passed."
echo "========================================================="
exit 0
