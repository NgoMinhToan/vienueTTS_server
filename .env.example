# vienueTTS_server Environment Configuration

# Server listener
PORT=8001
HOST=0.0.0.0

# Worker API Authentication Key (Clients must provide header: X-API-Key: <API_KEY>)
# If empty, access is unrestricted (recommended for development only).
API_KEY=vtts_worker_secret_key_123

# VieNeu-TTS AI Engine Configuration
VIENEU_MODE=v3turbo
VIENEU_PRECISION=fp32
VIENEU_THREADS=8

# ==============================================================================
# Hugging Face & Checkpoint Directory Configuration
# ==============================================================================
# HF_HOME: Thư mục cache chuẩn của Hugging Face Hub (nơi lưu các file ONNX, tokenizer, weights).
# Trong container Docker, mặc định mount vào /app/data/models.
# Trên máy host, bạn có thể trỏ tới thư mục ./models hoặc %USERPROFILE%\.cache\huggingface\hub
HF_HOME=/app/data/models

# VIENEU_MODELS_DIR: Alias nội bộ của microservice (tự động đồng bộ với HF_HOME).
VIENEU_MODELS_DIR=/app/data/models

# HF_HUB_OFFLINE: Cờ điều khiển việc kết nối ra ngoài để tải model từ Hugging Face
# - 0 (mặc định): Tự động kết nối Internet và tải các file model/ONNX nếu trong thư mục chưa có.
# - 1: Chế độ OFFLINE bắt buộc (Air-gapped / Local only). Chỉ đọc các file model đã có sẵn trong
#      thư mục HF_HOME/hub; tuyệt đối không kết nối ra Internet và báo lỗi 503 ngay nếu thiếu checkpoint.
HF_HUB_OFFLINE=0

# Đường dẫn mã nguồn vieneu nội bộ nếu dùng source dev thay vì pip package
VIENEU_SRC_DIR=/app/vieneu_src

# ==============================================================================
# Startup & Reliability Flags
# ==============================================================================
# SKIP_MODEL_PRELOAD:
# - 0 (khuyên dùng): Tự động tìm kiếm và nạp model ngay khi khởi động container (Eager Preload).
# - 1: Bỏ qua nạp trước lúc khởi động (chỉ dùng khi muốn boot cực nhanh trong môi trường test).
SKIP_MODEL_PRELOAD=0

# ALLOW_MOCK_SYNTHESIS:
# - 0 (mặc định, an toàn sản xuất): Trả lỗi HTTP 503 Service Unavailable ngay lập tức khi model chưa sẵn sàng.
# - 1: Cho phép tự động phát sóng hình sin 220Hz giả lập trong môi trường dev nhẹ không có GPU/weights.
ALLOW_MOCK_SYNTHESIS=0
